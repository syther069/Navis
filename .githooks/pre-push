#!/usr/bin/env sh
# Navis pre-push hook: refuse to push a ref whose tip has a package-lock.json
# with resolved URLs off https://registry.npmjs.org, or no lockfile at all.
# The tip is what Vercel builds, so that is what is checked. Runs only the
# lockfile check, nothing else.
set -eu

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  if ! git cat-file -e "$local_sha:package-lock.json" 2>/dev/null; then
    echo "pre-push: $local_ref ($local_sha) has no package-lock.json; push refused." >&2
    status=1
    continue
  fi
  tmp="$(mktemp)"
  git show "$local_sha:package-lock.json" > "$tmp"
  if ! node scripts/check-lockfile-registry.mjs "$tmp"; then
    echo "pre-push: package-lock.json at $local_sha ($local_ref) is poisoned; push refused." >&2
    status=1
  fi
  rm -f "$tmp"
done
exit $status
