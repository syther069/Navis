# Public application configuration
# Leave unset for the first Replit Publish. For an approved Vercel deployment,
# set the exact HTTPS origin (for example: https://navis-gilt.vercel.app).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Execution safety
# Valid values: demo, devnet, mainnet
NAVIS_EXECUTION_MODE=demo
ENABLE_DEMO_MODE=true
ENABLE_DEVNET_EXECUTION=false
ENABLE_MAINNET_EXECUTION=false
MAINNET_RELEASE_APPROVED=false

# Server-only infrastructure
# Optional in demo mode. When set, the Atlas page shows a read-only current-slot
# probe from this endpoint (no signing, no transactions).
SOLANA_RPC_URL=
DATABASE_URL=
SESSION_SECRET=

# Server-only sponsor integrations
# ClawPump Partner API key (format cpk_...), from https://clawpump.tech/developers.
# Without it the Markets page shows "Provider not configured"; with it Navis
# runs a real read-only GET /agents and stores a sanitised verification record.
CLAWPUMP_API_KEY=
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

# Server-only AI provider
# Valid values: demo, openai
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=
